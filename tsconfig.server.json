{
  "compilerOptions": {
    "target": "ES2022",
    "ignoreDeprecations": "6.0",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "composite": true,
    "declaration": true,
    "tsBuildInfoFile": "dist-server/tsconfig.server.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": false,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist-server"
  },
  "include": [
    "server/**/*.ts",
    "scripts/Drawings/HarvestablesDrawing.ts",
    "scripts/Drawings/MobsDrawing.ts",
    "scripts/Handlers/HandlerUtils.ts",
    "scripts/Handlers/HarvestablesHandler.ts",
    "scripts/Handlers/MobsHandler.ts",
    "scripts/Utils/DrawingUtils.ts",
    "scripts/classes/**/*.ts",
    "scripts/Utils/EventCodes.ts",
    "tests/**/*.ts",
    "tools/**/*.ts"
  ]
}
