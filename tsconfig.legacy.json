{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "composite": true,
    "declaration": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/tsconfig.legacy.tsbuildinfo",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": false,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist-runtime"
  },
  "include": ["scripts/**/*.ts", "scripts/**/*.d.ts"],
  "exclude": ["scripts/alpine.min.js"]
}
