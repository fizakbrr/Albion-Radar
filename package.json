{
  "name": "camel-radar",
  "version": "1.0.0",
  "description": "Camel-branded local Albion Online radar UI with optional packet capture.",
  "main": "app.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "serve": "node app.js",
    "start": "npm run build && node app.js",
    "start:no-capture": "set CAMEL_RADAR_CAPTURE=0&& set CAMEL_RADAR_OPEN_BROWSER=1&& npm run build && node app.js",
    "test": "npm run build && node --test"
  },
  "author": "fizakbrr",
  "contributors": [
    "Zeldruck",
    "FashionFlora"
  ],
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.20.0",
    "npm": ">=10.8.0"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.2.8",
    "buffercursor": "^0.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.22.2",
    "lucide-react": "^1.18.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "readline-sync": "^1.4.10",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "cap": "^0.2.1"
  },
  "overrides": {
    "cap": {
      "nan": "2.27.0"
    },
    "jake": {
      "minimatch": {
        ".": "3.1.5",
        "brace-expansion": "1.1.15"
      }
    },
    "filelist": {
      "minimatch": {
        ".": "5.1.9",
        "brace-expansion": "2.1.1"
      }
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
