{
  "name": "camel-albion-radar",
  "version": "1.0.0",
  "description": "Local Albion Online radar overlay and map utility with a React UI, Express/WebSocket runtime, and optional packet capture support.",
  "main": "dist-server/server/index.js",
  "scripts": {
    "build": "npm run build:client && npm run build:legacy && npm run build:server && npm run build:assets",
    "build:assets": "node dist-server/tools/copy-runtime-assets.js",
    "build:client": "vite build",
    "build:legacy": "tsc -p tsconfig.legacy.json",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "vite --host 127.0.0.1",
    "serve": "node dist-server/server/index.js",
    "start": "npm run build && node dist-server/server/index.js",
    "start:no-capture": "set CAMEL_RADAR_CAPTURE=0&& set CAMEL_RADAR_OPEN_BROWSER=1&& npm run build && node dist-server/server/index.js",
    "test": "npm run build && node --test dist-server/tests/app.test.js"
  },
  "keywords": [
    "albion-online",
    "albion-radar",
    "albion-online-radar",
    "albion-online-tools",
    "albion-online-utility",
    "albion-online-overlay",
    "albion-map-tool",
    "game-utility",
    "desktop-utility",
    "open-source-game-tool",
    "typescript",
    "react",
    "vite",
    "express",
    "websocket"
  ],
  "author": "fizakbrr",
  "contributors": [
    "Zeldruck",
    "FashionFlora"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fizakbrr/CamelRadar.git"
  },
  "bugs": {
    "url": "https://github.com/fizakbrr/CamelRadar/issues"
  },
  "homepage": "https://github.com/fizakbrr/CamelRadar#readme",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.20.0",
    "npm": ">=10.8.0"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.2.8",
    "buffercursor": "^0.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.22.2",
    "lucide-react": "^1.18.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "cap": "^0.2.1"
  },
  "overrides": {
    "cap": {
      "nan": "2.27.0"
    },
    "jake": {
      "minimatch": {
        ".": "3.1.5",
        "brace-expansion": "1.1.15"
      }
    },
    "filelist": {
      "minimatch": {
        ".": "5.1.9",
        "brace-expansion": "2.1.1"
      }
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
